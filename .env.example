# Postgres connection string.
# On Vercel + Neon, use the POOLED host (contains "-pooler") for serverless.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google Apps Script web app URL that receives RSVPs (see scripts/rsvp-sheet.gs).
# Set locally to test the form; in production it comes from the RSVP_ENDPOINT
# repository variable via .github/workflows/deploy.yml.
NEXT_PUBLIC_RSVP_ENDPOINT=""
